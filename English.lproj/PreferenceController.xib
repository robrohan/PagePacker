                        <textFieldCell key="cell" sendsActionOnEndEditing="YES" alignment="right" title="Paper:" id="33">
                            <font key="font" metaFont="system"/>
                            <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                            <color key="backgroundColor" name="controlColor" catalog="System" colorSpace="catalog"/>
                        </textFieldCell>
                    </textField>
                    <box fixedFrame="YES" title="Font for text files" translatesAutoresizingMaskIntoConstraints="NO" id="20">
                        <rect key="frame" x="9" y="16" width="316" height="65"/>
                        <autoresizingMask key="autoresizingMask"/>
                        <view key="contentView" id="nnd-hf-Pqp">
                            <rect key="frame" x="0.0" y="0.0" width="316" height="53"/>
