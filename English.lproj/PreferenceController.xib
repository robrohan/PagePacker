                <outlet property="textFontField" destination="17" id="19"/>
                <outlet property="window" destination="5" id="13"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <window title="Preferences" allowsToolTipsWhenApplicationIsInactive="NO" autorecalculatesKeyViewLoop="NO" releasedWhenClosed="NO" visibleAtLaunch="NO" animationBehavior="default" id="5" userLabel="Window">
            <windowStyleMask key="styleMask" titled="YES" closable="YES" miniaturizable="YES"/>
            <windowPositionMask key="initialPositionMask" leftStrut="YES" rightStrut="YES" topStrut="YES" bottomStrut="YES"/>
            <rect key="contentRect" x="3" y="868" width="342" height="128"/>
            <rect key="screenRect" x="0.0" y="0.0" width="1920" height="1050"/>
            <view key="contentView" id="6">
                <rect key="frame" x="0.0" y="0.0" width="342" height="128"/>
                <autoresizingMask key="autoresizingMask"/>
                <subviews>
                    <popUpButton imageHugsTitle="YES" verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="7">
                        <rect key="frame" x="84" y="91" width="202" height="26"/>
                        <autoresizingMask key="autoresizingMask"/>
                        <popUpButtonCell key="cell" type="push" title="Letter (8.5&quot; x 11&quot;)" bezelStyle="rounded" alignment="left" lineBreakMode="truncatingTail" state="on" borderStyle="borderAndBezel" inset="2" arrowPosition="arrowAtCenter" preferredEdge="maxY" selectedItem="10" id="32">
                            <behavior key="behavior" lightByBackground="YES" lightByGray="YES"/>
                            <font key="font" metaFont="message"/>
                            <menu key="menu" title="OtherViews" id="8">
                                <items>
                                    <menuItem title="Letter (8.5&quot; x 11&quot;)" state="on" id="10"/>
                                    <menuItem title="A4 (210mm x 297mm)" tag="1" id="9"/>
                                </items>
                            </menu>
